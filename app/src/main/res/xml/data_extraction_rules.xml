<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup na nuvem e transferência entre aparelhos (Android 12+).
   A chave da API Groq fica só neste aparelho: o arquivo de preferências não sai daqui.
   Ver https://developer.android.com/about/versions/12/backup-restore
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="teclado_pt_br_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="teclado_pt_br_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
